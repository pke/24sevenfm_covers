{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/backdrop.js": {
      "maxDuration": 15
    },
    "api/tint.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/ratings/fsk/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
