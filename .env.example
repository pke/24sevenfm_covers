# TMDB accepts either a v3 application key or a v4 Read Access Token. For
# compatibility, a v4 token under TMDB_API_KEY is auto-detected as well.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# fanart.tv project key. If omitted, the resolver falls back to TMDB artwork.
FANART_API_KEY=

# SteamGridDB key generated at https://www.steamgriddb.com/profile/preferences/api.
# It remains server-side; the browser receives only selected CDN image URLs.
STEAMGRIDDB_API_KEY=

# Optional JSON map for titles that are genuinely ambiguous across catalogs.
# Keys are normalized album/work titles; values: game, movie, tv, or screen.
# BACKDROP_MEDIA_OVERRIDES={"Prey":"game","The Last of Us":"tv"}

# Comma-separated browser origins allowed to call the endpoint cross-origin.
# Same-origin requests do not need a CORS header.
BACKDROP_ALLOWED_ORIGINS=https://24sevenfm-covers.dudesoft.app

# Exact hosts accepted by /api/tint. Keep this narrow: the endpoint rejects every
# other host and permits only /images/cover/<file> and /images/cover/040/<file> paths.
TINT_ALLOWED_HOSTS=streamingsoundtracks.com,1980s.fm,adagio.fm,death.fm,entranced.fm
