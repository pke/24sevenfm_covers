// options_page.rc - the shared options dialog, #included by each host's .rc so the
// layout is defined once. A child dialog (DS_CONTROL | WS_CHILD): Winamp hosts it as
// the "Options" tab page, foobar2000 as its preferences page. Control logic lives in
// shared/options_panel.cpp.
#include <windows.h>
#include <commctrl.h>
#include "options_ids.h"

IDD_OPTIONS_PAGE DIALOGEX 0, 0, 230, 320
STYLE DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Layout:",       -1,              8, 9, 40, 10, WS_GROUP
    AUTORADIOBUTTON "&Fill screen",  IDC_OPT_LAYOUT,   50, 8, 62, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Poster",       IDC_OPT_LAYOUT+1, 116, 8, 50, 10

    AUTOCHECKBOX    "Show &remaining time", IDC_OPT_OVERLAY, 8, 24, 190, 12, WS_GROUP | WS_TABSTOP

    LTEXT           "Size:",         -1,              8, 41, 40, 10, WS_GROUP
    AUTORADIOBUTTON "S&mall",        IDC_OPT_SIZE,     50, 40, 40, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "M&edium",       IDC_OPT_SIZE+1,   92, 40, 46, 10
    AUTORADIOBUTTON "&Large",        IDC_OPT_SIZE+2,   140, 40, 44, 10

    AUTOCHECKBOX    "&Animate the countdown digits (rolling)",   IDC_OPT_ROLL,    8, 56, 190, 12, WS_GROUP | WS_TABSTOP

    LTEXT           "Transition:",   -1,              8, 73, 42, 10, WS_GROUP
    AUTORADIOBUTTON "&None",         IDC_OPT_TRANS,    50, 72, 32, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Crossfade",    IDC_OPT_TRANS+1,  84, 72, 50, 10
    AUTORADIOBUTTON "Flip &H",       IDC_OPT_TRANS+2,  136, 72, 32, 10
    AUTORADIOBUTTON "Flip &V",       IDC_OPT_TRANS+3,  170, 72, 32, 10

    LTEXT           "Duration:",     -1,              8, 92, 40, 10, WS_GROUP
    CONTROL         "", IDC_OPT_FADE, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,                       50, 89, 116, 18
    LTEXT           "500 ms",        IDC_OPT_FADEVAL, 170, 92, 30, 10

    GROUPBOX        "StreamingSoundtracks media", -1, 6, 113, 218, 204
    AUTOCHECKBOX    "Show movie, TV && game &backdrops", IDC_OPT_BACKDROPS, 13, 126, 180, 12, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "&Hide the square cover when a backdrop is shown", IDC_OPT_HIDECOVER, 24, 140, 194, 12, WS_TABSTOP
    AUTOCHECKBOX    "Show age &ratings", IDC_OPT_RATINGS, 13, 156, 105, 12, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "&DE (FSK)", IDC_OPT_RATING_DE, 121, 156, 48, 12, WS_TABSTOP
    AUTOCHECKBOX    "&US", IDC_OPT_RATING_US, 172, 156, 34, 12, WS_TABSTOP
    LTEXT           "Artwork providers (top first):", -1, 13, 173, 132, 10
    CONTROL         "", IDC_OPT_PROVIDERS, "SysListView32",
                    LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_VSCROLL | WS_TABSTOP,
                    13, 184, 158, 72
    PUSHBUTTON      "&Up", IDC_OPT_PROVIDER_UP, 177, 184, 39, 14, WS_TABSTOP
    PUSHBUTTON      "&Down", IDC_OPT_PROVIDER_DOWN, 177, 202, 39, 14, WS_TABSTOP
    // Replaced at runtime by IDD_OPT_PROVIDER_DETAILS. Keeping a template control
    // gives every host the same dialog-unit placement without hard-coded pixels.
    LTEXT           "", IDC_OPT_PROVIDER_DETAILS, 13, 258, 203, 49
END

// One real child window contains the selected provider's link, attribution and
// optional fanart.tv key controls. The shared implementation fades this whole
// surface between providers so outgoing content remains visible during transition.
IDD_OPT_PROVIDER_DETAILS DIALOGEX 0, 0, 203, 49
STYLE DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "", IDC_OPT_PROVIDER_LINK, 0, 0, 203, 10, SS_NOTIFY | SS_NOPREFIX
    LTEXT           "", IDC_OPT_PROVIDER_ATTRIBUTION, 0, 13, 203, 28, SS_NOPREFIX
    LTEXT           "Personal client key:", IDC_OPT_FANART_KEY_LABEL, 0, 13, 91, 10
    LTEXT           "Why?", IDC_OPT_FANART_KEY_WHY, 94, 13, 25, 10, SS_NOTIFY | SS_NOPREFIX
    LTEXT           "Get one", IDC_OPT_FANART_KEY_GET, 123, 13, 36, 10, SS_NOTIFY | SS_NOPREFIX
    EDITTEXT        IDC_OPT_FANART_KEY, 0, 24, 157, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Check", IDC_OPT_FANART_KEY_CHECK, 162, 24, 41, 14, WS_TABSTOP
    LTEXT           "", IDC_OPT_FANART_KEY_STATUS, 0, 39, 203, 10, SS_NOPREFIX
END
